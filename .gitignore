# Secrets - never commit
.env
.env.local
*.pem
*.key
.credential_key
# The glob matters: a copy taken before a repair (credentials.enc.bak-*)
# is the same secret under a name the bare pattern does not match, and
# `git add -A` would have committed it.
credentials.enc*

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local scratch
*.log
*.csv
pytest_out.txt
pytest_output.txt
python_test.txt
acceptance-report.json

# Policy snapshots are local audit evidence, not source
snapshots/
internal-fw.json
gaia-probe.json
health-baselines/

