# Addresses below are RFC 5737 documentation ranges. Replace them with your
# own; nothing real should be committed in this file.
CHECKPOINT_MGMT=https://192.0.2.10
CHECKPOINT_USER=api_user
CHECKPOINT_PASSWORD=change_me
CHECKPOINT_DOMAIN=
CHECKPOINT_VERIFY_SSL=false
CHECKPOINT_TIMEOUT=90
CHECKPOINT_MIN_REQUEST_INTERVAL=0.55
CHECKPOINT_RATE_LIMIT_RETRIES=4
CHECKPOINT_RATE_LIMIT_BASE_DELAY=2
CHECKPOINT_CACHE_TTL=300

# Credentials saved on the Settings page are encrypted into credentials.enc
# and OVERRIDE the values above at startup. If a saved address is wrong,
# nobody can sign in; `python -m tools.reset_credentials` shows which source
# each value came from and can clear a saved record so this file applies.
# The sign-in form uses the same Check Point account: there is no separate
# application password.

# --- Gaia API (optional) -------------------------------------------------
# Routing, interfaces and cluster state come from the Gaia API on each
# gateway, which is a different API and different credentials from the
# Management Server. Leave GAIA_ENABLED=false and nothing changes.
# Only read commands are ever issued; see the allowlist in app/gaia.py.
GAIA_ENABLED=false
GAIA_USER=
GAIA_PASSWORD=
GAIA_HOSTS=192.0.2.11,192.0.2.12
GAIA_VERIFY_SSL=false
GAIA_TIMEOUT=30
